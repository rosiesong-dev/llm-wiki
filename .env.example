# LLM 백엔드 선택 ("gemini", "gemma" 또는 "claude")
LLM_BACKEND=gemini

# Google Gemini AI 설정
# API 키는 python main.py set-gemini-key 로 Windows 자격 증명 관리자에 저장 (여기 직접 적어도 동작)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Gemma AI 설정 (Ollama 등 로컬 또는 호스팅 엔드포인트)
GEMMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma2:9b
GEMMA_EMBEDDING_MODEL=nomic-embed-text
# Ollama 컨텍스트 크기 (긴 원본이 잘리지 않도록. 클수록 메모리 사용 증가)
GEMMA_NUM_CTX=8192

# Claude 설정 (Anthropic API)
# API 키는 python main.py set-claude-key 로 Windows 자격 증명 관리자에 저장 (ANTHROPIC_API_KEY 환경변수도 동작)
CLAUDE_MODEL=claude-opus-5-5
# Claude는 임베딩 API가 없어 RAG 임베딩은 "gemma" 또는 "gemini"가 담당 (바꾸면 python main.py index 재실행)
CLAUDE_EMBEDDING_BACKEND=gemma

# Confluence API 설정 (Atlassian Cloud)
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=user@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token_here
CONFLUENCE_SPACE_KEY=DEV

# Jira 연동 설정 (선택 사항)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=user@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=DEV

# 저장소 경로 설정
RAW_STORAGE_PATH=./storage/raw
WIKI_STORAGE_PATH=./storage/wiki
INDEX_STORAGE_PATH=./storage/index
TICKETS_STORAGE_PATH=./storage/tickets

# Slack 설정 (Bot 토큰은 'python main.py set-slack-token'으로 Windows 자격 증명 관리자에 저장)
SLACK_CHANNEL_ID=C0XXXXXXXXX
